# QR Attendance ERP System - Environment Configuration
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=change-this-to-a-super-secret-cryptographic-key-32-chars

# Database URL
# SQLite default: sqlite:///qr_attendance.db
# PostgreSQL (Production): postgresql://user:password@localhost:5432/qr_erp
DATABASE_URL=sqlite:///qr_attendance.db

# Institution Defaults
INSTITUTION_NAME=Apex Institute of Technology & Management
INSTITUTION_EMAIL=contact@apex-institute.edu
INSTITUTION_PHONE=+1-555-0199
INSTITUTION_ADDRESS=100 Academic Way, Tech Corridor, Metro City

# Upload Configuration
UPLOAD_FOLDER=app/static/uploads
MAX_CONTENT_LENGTH=2097152

# Email / SMTP Configuration
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=noreply@apex-institute.edu
